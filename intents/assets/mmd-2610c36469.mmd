flowchart LR
    subgraph K["客戶模組"]
        K1["客戶・列表／詳細<br/>（看歷次報價單）"]
        K2["客戶挑選框<br/>（內嵌於開新單：可搜、可當場新增）"]
    end
    subgraph P["商品模組"]
        P1["商品・列表<br/>（建改商品、預設單價）"]
    end
    subgraph Q["報價單模組"]
        Q1["報價單・列表"]
        Q2["報價單・開新單"]
        Q3["報價單・詳細"]
    end
    subgraph O["訂單模組"]
        O1["訂單・列表"]
        O2["訂單・詳細"]
    end
    subgraph S["橫切支援（所有模組使用）"]
        U1["使用者・登入"]
        L1["操作紀錄<br/>（顯示於單據詳細頁）"]
    end
    K2 -.帶入客戶.-> Q2
    P1 -.帶入品項（明細存快照）.-> Q2
    Q3 -->|成交轉訂單| O2
    classDef cust fill:#F1EFE8,stroke:#888780,color:#2C2C2A
    classDef prod fill:#FAECE7,stroke:#D85A30,color:#4A1B0C
    classDef quote fill:#EEEDFE,stroke:#7F77DD,color:#26215C
    classDef order fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    class K1,K2 cust
    class P1 prod
    class Q1,Q2,Q3 quote
    classDef supp fill:#F1EFE8,stroke:#888780,color:#2C2C2A
    class O1,O2 order
    class U1,L1 supp
    style S stroke:#888780,stroke-dasharray:6 4